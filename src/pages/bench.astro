---
import Layout from "../layouts/Layout.astro";
import ArenaFooter from "../components/ArenaFooter.astro";
import ArenaHeader from "../components/ArenaHeader.astro";
---

<Layout>
	<div class="app-shell flex flex-col">
		<ArenaHeader variant="review" label="Benchmarks" />

		<main class="flex-1 pb-10">
			<section class="pb-6 pt-6 lg:pt-8">
				<h1 class="max-w-3xl text-balance text-[clamp(1.7rem,3.6vw,2.8rem)] font-semibold leading-[1.05] tracking-[-0.04em] text-[var(--color-ink)]">
					Custom benchmarks. Graded answers.
				</h1>
				<p class="mt-3 max-w-2xl text-[13px] leading-6 text-[var(--color-ink-dim)]">
					Write questions with their expected answers, force every model into a
					<code class="rounded bg-[var(--color-panel-hi)] px-1 py-0.5 text-[11px]">{"{\"answer\": …}"}</code>
					reply, and score who actually gets them right.
				</p>
			</section>

			<div class="panel-premium grid lg:grid-cols-[minmax(0,1.4fr)_minmax(17rem,0.75fr)]">
				<!-- ============================== SUITE EDITOR ============================== -->
				<div class="min-w-0 border-b border-[var(--color-line)] p-4 sm:p-5 lg:border-b-0 lg:border-r">
					<div class="flex items-center justify-between gap-3">
						<p class="composer-label"><span class="composer-step">01</span> Suite</p>
						<span class="text-[11px] text-[var(--color-ink-faint)]"><span id="case-count">0</span> cases</span>
					</div>

					<div class="mt-3 flex gap-2">
						<input
							id="suite-name"
							type="text"
							placeholder="Suite name"
							class="control-surface w-full px-3 py-2 text-[13px] outline-none focus:border-[var(--color-accent)]/50"
						/>
						<select
							id="lang"
							aria-label="Suite type"
							class="control-surface shrink-0 px-2.5 py-2 text-[12px] outline-none focus:border-[var(--color-accent)]/50"
						>
							<option value="text">Q&amp;A</option>
							<option value="js">JavaScript</option>
						</select>
					</div>

					<div id="code-fields" class="mt-2 hidden">
						<textarea
							id="task"
							rows="2"
							placeholder="Task: what the function has to do (the models read this)"
							class="control-surface no-scrollbar w-full resize-y px-3 py-2 text-[12px] outline-none focus:border-[var(--color-accent)]/50"
						></textarea>
						<label class="mt-2 flex items-center gap-2 text-[11px] text-[var(--color-ink-faint)]">
							<span>function</span>
							<input
								id="entry"
								type="text"
								spellcheck="false"
								class="control-surface w-40 px-2.5 py-1.5 font-mono text-[11px] text-[var(--color-ink)] outline-none focus:border-[var(--color-accent)]/50"
							/>
							<span>— runs in a worker here, with a 5s timeout</span>
						</label>
					</div>

					<div id="cases" class="mt-3 flex flex-col gap-2"></div>

					<div class="mt-3 flex flex-wrap items-center gap-2">
						<button id="add-case" class="control-surface flex min-h-9 items-center gap-1.5 border-dashed px-3 text-[12px] hover:!border-[var(--color-accent)]">
							<svg class="size-4"><use href="#i-plus"></use></svg>
							<span>Add case</span>
						</button>
						<label class="control-surface flex min-h-9 cursor-pointer items-center gap-1.5 px-3 text-[12px]" title="Import a JSON suite">
							<svg class="size-4"><use href="#i-up"></use></svg>
							<span>Import JSON</span>
							<input id="import" type="file" accept="application/json,.json" class="hidden" />
						</label>
						<button id="export" class="control-surface flex min-h-9 items-center gap-1.5 px-3 text-[12px]">
							<svg class="size-4"><use href="#i-down"></use></svg>
							<span>Export</span>
						</button>
						<button id="example" class="text-[11px] text-[var(--color-ink-faint)] underline-offset-2 hover:text-[var(--color-ink)] hover:underline">
							load example
						</button>
						<span id="import-error" class="hidden text-[11px] text-red-400"></span>
					</div>

					<details id="json-panel" class="mt-4 text-[11px] text-[var(--color-ink-faint)]">
						<summary class="cursor-pointer hover:text-[var(--color-ink)]">JSON — copy or paste</summary>
						<textarea
							id="json"
							rows="10"
							spellcheck="false"
							aria-label="Suite as JSON"
							class="control-surface no-scrollbar mt-2 w-full resize-y p-3 font-mono text-[10.5px] leading-relaxed text-[var(--color-ink)] outline-none focus:border-[var(--color-accent)]/50"
						></textarea>
						<div class="mt-2 flex flex-wrap items-center gap-2">
							<button id="copy-json" class="control-surface flex min-h-8 items-center gap-1.5 px-2.5 text-[11px]">
								<svg class="size-3.5"><use href="#i-copy"></use></svg>
								<span>Copy</span>
							</button>
							<button id="apply-json" class="control-surface flex min-h-8 items-center gap-1.5 px-2.5 text-[11px]">
								<svg class="size-3.5"><use href="#i-check"></use></svg>
								<span>Apply pasted JSON</span>
							</button>
							<span id="json-status" class="text-[10px]"></span>
						</div>
						<p class="mt-2 leading-relaxed">
							Q&amp;A: <code>{`{"q": "…", "a": ["…", "…"]}`}</code> ·
							JavaScript: <code>{`{"lang":"js","entry":"solve","task":"…","cases":[{"in":[[1,2]],"out":3}]}`}</code>
						</p>
					</details>
				</div>

				<!-- ================================ MODELS ================================ -->
				<div class="min-w-0 p-4 sm:p-5">
					<div class="flex items-center justify-between gap-3">
						<p class="composer-label"><span class="composer-step">02</span> Models</p>
						<a href="/" class="text-[11px] text-[var(--color-ink-faint)] underline-offset-2 hover:text-[var(--color-ink)] hover:underline">pick in arena</a>
					</div>
					<p class="mt-2 text-[12px] leading-relaxed text-[var(--color-ink-faint)]">
						Uses the models and API keys you already configured in the arena.
					</p>
					<div id="models" class="mt-3 flex flex-col gap-1.5"></div>

					<div class="mt-4 border-t border-[var(--color-line)] pt-3">
						<button id="run" class="flex min-h-11 w-full items-center justify-center gap-2 rounded-xl bg-[var(--color-accent)] px-4 text-[13px] font-medium text-black transition-opacity hover:opacity-90 disabled:opacity-40">
							<svg class="icon-fill size-4"><use href="#i-play"></use></svg>
							<span id="run-label">Run benchmark</span>
						</button>
						<p id="progress" class="mt-2 text-center text-[11px] text-[var(--color-ink-faint)]"></p>
					</div>
				</div>
			</div>

			<!-- ================================ RESULTS ================================ -->
			<section class="mt-6" aria-live="polite">
				<div class="flex flex-wrap items-center justify-between gap-3">
					<div class="section-label">
						<svg class="size-3.5"><use href="#i-trophy"></use></svg>
						<span>Scoreboard</span>
					</div>
					<div id="runs" class="flex flex-wrap items-center gap-1.5"></div>
				</div>
				<div id="results" class="mt-3"></div>
			</section>
		</main>

		<ArenaFooter review />
	</div>
</Layout>

<script src="../scripts/bench.ts"></script>
